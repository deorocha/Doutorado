// Charlie: papel Worker -> otimiza código (task) + contribui para softgoal
+!otimizar_codigo <-
    .print("Charlie: otimizando código (task)");
    .wait(300);
    send(alice,inform,codigo_otimizado);
    !melhorar_escalabilidade.

+!melhorar_escalabilidade <-
    .print("Charlie: softgoal escalabilidade melhorada").